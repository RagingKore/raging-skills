{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}/scripts/lint-markdown.cs\"",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
