  "assertions": [
    {"text": "Uses semantic <nav> element for navigation bar", "type": "check"},
    {"text": "Contains email input with placeholder text 'Enter your email...'", "type": "check"},
    {"text": "Contains a Subscribe button", "type": "check"},
    {"text": "Checkbox is checked by default (checked attribute)", "type": "check"},
    {"text": "Card structure with 'Welcome' as the title/header", "type": "check"},
    {"text": "Contains navigation links: Home, About, Contact", "type": "check"},
    {"text": "Contains Sign Up button", "type": "check"},
    {"text": "No elaborate CSS framework or excessive styling beyond basic layout", "type": "check"}
  ]
}
