{
  "eval_id": 2,
  "eval_name": "wireframe-to-basecoat",
  "prompt": "Convert this wireframe to Basecoat UI with Lucide icons:\n```\n[ Tab 1 ]   Tab 2   Tab 3\n──────────────────────────\n\n[/ Search...            ]\n\n┌──────────┬──────────┬──────────┐\n│ Name     │ Email    │ Role     │\n├──────────┼──────────┼──────────┤\n│          │          │          │\n│          │          │          │\n│          │          │          │\n└──────────┴──────────┴──────────┘\n\n< 1 2 [3] 4 5 ... >\n```",
  "assertions": [
    "Includes Basecoat CSS dependency (CDN or import)",
    "Uses Basecoat 'tabs' and 'tab active' classes",
    "Uses Lucide search icon (data-lucide='search')",
    "Uses Basecoat 'table' class on table element",
    "Uses Lucide chevron icons for pagination arrows",
    "Page 3 is visually active/selected in pagination",
    "Tab 1 is the active tab",
    "Table rows are empty — preserves wireframe content without fabricated data",
    "Calls lucide.createIcons() to initialize icons"
  ]
}
